                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- 忽略所有错误 -->
                            <failOnError>false</failOnError>

                            <!-- 忽略特定错误 -->
                            <additionalOptions>
                                <additionalOption>-Xdoclint:none</additionalOption>
                            </additionalOptions>

                            <!-- 或更细粒度的控制 -->
                            <doclint>none</doclint>
                        </configuration>
