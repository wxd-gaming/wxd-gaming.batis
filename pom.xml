<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.wxd-gaming</groupId>
    <artifactId>wxd-gaming.batis</artifactId>
    <version>1.1.1</version>
    <packaging>pom</packaging>


    <!--
      项目信息：name 与聚合 artifactId 对齐。
      description 采用「英文段落在前、中文段落在后」的双语写法，两段描述的是同一批事实，
      改动任一段时必须同步另一段，否则中文读者与英文读者会看到两套互相矛盾的说明。
      每段都要点明「这是什么 + 别人该依赖哪个模块」，方便 Maven Central 检索。
    -->
    <name>wxd-gaming.batis</name>
    <description>
        wxd-gaming.batis is a lightweight JDBC-first ORM for Java 21, built for game-server data access.
        Annotations on the entity class describe the whole table at once - name, columns, indexes and
        primary-key strategy - and the framework turns them into DDL, then diffs the same rendering against
        the live schema so existing tables converge with zero drift. On top of that it offers a type-safe
        query DSL, batch read/write, programmatic transactions, partitioned-table maintenance and
        write-behind caching. It talks plain JDBC through HikariCP; no Spring or MyBatis is involved.
        This is the aggregator POM. Depend on com.wxdgaming.batis.sql.mysql or
        com.wxdgaming.batis.sql.pgsql instead - each brings the core metadata layer and the
        dialect-neutral SQL engine with it.

        wxd-gaming.batis 是面向游戏服务端数据访问场景的轻量级 JDBC ORM（Java 21）。实体类上的注解
        一次性描述表名、列、索引与主键策略，框架据此生成 DDL，并把同一份渲染结果与库端结构比对，
        让存量表零漂移收敛；在此之上提供类型安全查询 DSL、批量读写、编程式事务、分区表维护与
        Write-Behind 缓存。全程走原生 JDBC（HikariCP 连接池），不依赖 Spring 与 MyBatis。
        本 POM 只是聚合工程，请依赖 com.wxdgaming.batis.sql.mysql 或 com.wxdgaming.batis.sql.pgsql，
        它们会自动带入元数据层与方言无关的 SQL 层。
    </description>
    <url>https://github.com/wxd-gaming/wxd-gaming.batis</url>

    <!-- SCM 信息 -->
    <scm>
        <connection>scm:git:https://github.com/wxd-gaming/wxd-gaming.batis.git</connection>
        <developerConnection>scm:git:https://github.com/wxd-gaming/wxd-gaming.batis.git</developerConnection>
        <url>https://github.com/wxd-gaming/wxd-gaming.batis</url>
    </scm>

    <!-- 许可证 -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <!-- 开发者信息 -->
    <developers>
        <developer>
            <name>wxd-gaming</name>
            <email>492794628@qq.com</email>
        </developer>
    </developers>

    <!--
      发布走 central-publishing-maven-plugin（extensions=true 接管 deploy，不读 distributionManagement），
      serverId 在 deploy profile 里配置（central），token 配在 settings.xml 的对应 server 上。
    -->

    <!-- 仓库中心地址 -->
    <distributionManagement>
        <snapshotRepository>
            <id>s01</id>
            <url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
        </snapshotRepository>
        <repository>
            <id>s01</id>
            <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>
        </repository>
    </distributionManagement>

    <modules>
        <module>com.wxdgaming.batis</module>
        <module>com.wxdgaming.batis.sql</module>
        <module>com.wxdgaming.batis.sql.mysql</module>
        <module>com.wxdgaming.batis.sql.pgsql</module>
        <!--
          mongodb 模块仍是未实现的占位（仅一个空类），暂不纳入构建，
          避免打出空 jar 让使用方误引入；落地实现后再加回：
        <module>com.wxdgaming.batis.mongodb</module>
        -->
    </modules>

    <properties>
        <encoding>utf-8</encoding>
        <java.version>21</java.version>
        <!--
          只设置 release，不再单独设置 source/target：release 会同时约束「语法级别」与
          「可引用的 JDK API」，避免在 JDK 25 等更高版本上编译时误用 21 之后才有的 API。
          注意不要再用 ${java.version} 去赋值 maven.compiler.source/target：那样会跟随执行
          构建的 JDK 版本变化，正是新环境编译结果不一致的根源。
        -->
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>${encoding}</project.build.sourceEncoding>
        <project.reporting.outputEncoding>${encoding}</project.reporting.outputEncoding>
        <maven.compiler.encoding>${encoding}</maven.compiler.encoding>
        <!-- 可复现构建：固定 jar 内条目时间戳，两次构建产物字节一致 -->
        <project.build.outputTimestamp>2026-10-15T00:00:00Z</project.build.outputTimestamp>
        <logback.version>1.5.36</logback.version>
        <slf4j.version>2.0.18</slf4j.version>
        <!-- 嵌入式 PostgreSQL 测试用发行包版本（zonky embedded-postgres 的默认版本，与驱动无关） -->
        <embedded.postgres.version>14.22.0</embedded.postgres.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>5.11.4</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>1.18.46</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>2.0.65</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-core</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.protostuff</groupId>
                <artifactId>protostuff-core</artifactId>
                <version>1.8.0</version>
            </dependency>
            <dependency>
                <groupId>io.protostuff</groupId>
                <artifactId>protostuff-runtime</artifactId>
                <version>1.8.0</version>
            </dependency>
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>3.2.2</version>
            </dependency>
            <!--
              嵌入式 PostgreSQL 的 BOM：它按平台把各操作系统/架构的 PG 发行包声明成 runtime 依赖，
              PG 版本由 BOM 统一决定。只用它的 dependencyManagement，产物里不会引入任何东西。
              不在子模块里各写一份版本，避免 pgsql 模块与将来可能的其它 PG 用库版本漂移。
            -->
            <dependency>
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>${embedded.postgres.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
      共享依赖只放"每个模块都真实需要"的：
      slf4j-api（全模块日志门面）、lombok、junit、logback（仅测试）。
      fastjson2/protostuff 这类单模块依赖在各模块 pom 里自行声明（版本仍由上面 dependencyManagement 管），
      避免使用方引入某个方言模块时被塞一堆用不上的传递依赖。
    -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 显式锁定 surefire 3.x：2.x 无法发现 JUnit 5 测试 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <!-- Source JAR -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.2.1</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Javadoc JAR -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.4.1</version>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- GPG 签名 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                    <executions>
                        <execution>
                            <id>sign-artifacts</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>sign</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!--
                  Maven Central 发布（Central Portal）：extensions=true 接管 deploy 阶段，
                  旧的 OSSRH s01 端点已于 2025-06 停服，不要再引入 nexus-staging 插件。
                -->
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.12.0</version>
                    <extensions>true</extensions>
                    <configuration>
                        <publishingServerId>central</publishingServerId>
                        <autoPublish>true</autoPublish>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>

        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <!-- 可选：指定包含的文件 -->
                <includes>
                    <include>**/*.properties</include>
                    <include>**/*.xml</include>
                    <include>**/*.json</include>
                    <include>**/*.yml</include>
                    <include>**/*.yaml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <!-- 可选：指定包含的文件 -->
                <includes>
                    <include>**/*.*</include>
                </includes>
            </resource>
        </resources>
    </build>

    <profiles>
        <profile>
            <id>deploy</id>
            <build>
                <plugins>
                    <!-- Source JAR -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Javadoc JAR -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- 忽略所有错误 -->
                            <failOnError>false</failOnError>

                            <!-- 忽略特定错误 -->
                            <additionalOptions>
                                <additionalOption>-Xdoclint:none</additionalOption>
                            </additionalOptions>

                            <!-- 或更细粒度的控制 -->
                            <doclint>none</doclint>
                        </configuration>
                    </plugin>
                    <!-- GPG 签名 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>s01</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>