<?xml version="1.0" encoding="UTF-8" ?>
<configuration debug="false">
    <!--关闭自身日志-->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>
    <property name="LOG_PATH" value="target/logs"/>
    <property name="LOG_PATTERN" value="[%d{MM-dd HH:mm:ss.SSS}] [%-5level] [%thread] [%C{0}#%M:%L] - %msg%n"/>

    <appender name="file_info" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/pgsql-app.log</file>
        <append>true</append>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_PATTERN}</pattern>
            <charset>utf-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/pgsql-app-%d{yyyyMMdd}-%i.log.gz</fileNamePattern>
            <maxFileSize>2GB</maxFileSize>
            <maxHistory>15</maxHistory>
        </rollingPolicy>
    </appender>

    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!--
      嵌入式 PG 的 postmaster 输出量很大（每条启动参数、每个 checkpoint），
      根级别留在 info：方言层的 debug 日志（生成的 DDL、执行耗时）在单测里不是要看的对象，
      需要时按包名单开：-Dlogback 或改这里。
    -->
    <logger name="io.zonky" level="info" additivity="false">
        <appender-ref ref="file_info"/>
    </logger>
    <logger name="com.zaxxer.hikari" level="warn"/>

    <root level="info">
        <appender-ref ref="file_info"/>
        <appender-ref ref="console"/>
    </root>
</configuration>
